/**
 * TableDiff 全局样式表
 * 主题：现代简洁 · 蓝色主调 #2563EB · 统一间距 · 圆角 8-10px
 */

/* ===== 全局字体 ===== */
* {
    font-family: -apple-system, "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
}

/* ===== 主窗口 ===== */
QMainWindow {
    background-color: #F1F5F9;
}

/* ===== 通用 QFrame 面板 ===== */
QFrame {
    border-radius: 10px;
}

/* ===== 对话框 ===== */
QDialog {
    background-color: #FFFFFF;
}

/* ===== 菜单栏 ===== */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    padding: 2px 0;
    font-size: 12px;
    color: #1E293B;
}
QMenuBar::item:selected {
    background-color: #EFF6FF;
    color: #2563EB;
    border-radius: 4px;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 4px;
    font-size: 12px;
}
QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #EFF6FF;
    color: #2563EB;
}
QMenu::separator {
    height: 1px;
    background-color: #E2E8F0;
    margin: 4px 8px;
}

/* ===== 通用按钮 ===== */
QPushButton {
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
}
QPushButton:hover {
    border-color: #2563EB;
}
QPushButton:disabled {
    color: #94A3B8;
}

/* ===== 状态栏 ===== */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    padding: 2px 12px;
    font-size: 12px;
    color: #64748B;
}

/* ===== 滚动条 ===== */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ===== 分割器 ===== */
QSplitter::handle {
    background-color: #E2E8F0;
    width: 2px;
}

/* ===== 表格通用 ===== */
QTableView {
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background-color: #FFFFFF;
    gridline-color: #F1F5F9;
    font-size: 12px;
    outline: none;
}
QTableView::item:selected {
    background-color: transparent;
    color: #1E293B;
}
QTableView::item:hover {
    background-color: transparent;
}
QHeaderView::section {
    background-color: #1E293B;
    color: white;
    font-weight: 600;
    font-size: 11px;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #334155;
    border-bottom: 1px solid #334155;
}

/* ===== 输入框 ===== */
QComboBox, QLineEdit {
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    background-color: #FFFFFF;
    color: #1E293B;
}
QComboBox:hover, QLineEdit:hover {
    border-color: #2563EB;
}
QComboBox:focus, QLineEdit:focus {
    border-color: #2563EB;
    background-color: #FFFFFF;
}
QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

/* ===== 复选框 ===== */
QCheckBox {
    font-size: 12px;
    color: #1E293B;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}
QCheckBox::indicator:hover {
    border-color: #2563EB;
}
QCheckBox:disabled {
    color: #94A3B8;
}

/* ===== 标签 ===== */
QLabel {
    color: #1E293B;
}

/* ===== 分组框 ===== */
QGroupBox {
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 8px;
    font-size: 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #1E293B;
}

/* ===== 工具提示 ===== */
QToolTip {
    background-color: #1E293B;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ===== 进度条 ===== */
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #F1F5F9;
    height: 6px;
    text-align: center;
    font-size: 10px;
}
QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 4px;
}

/* ===== 消息框按钮 ===== */
QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 20px;
}
